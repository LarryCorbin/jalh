{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx tsx generate-sitemap.js && tsx server.ts",
    "start": "node dist/server.js",
    "build": "npx tsx generate-sitemap.js && vite build && npx tsx prerender.js && esbuild server.ts --bundle --platform=node --outfile=dist/server.js --external:vite --external:express --format=esm",
