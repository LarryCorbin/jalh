{
  "entities": {
    "submission": {
      "title": "Contact Submission",
      "description": "Form submission from the contact gateway",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The sender's name" },
        "email": { "type": "string", "format": "email", "description": "The sender's email address" },
        "subject": { "type": "string", "description": "The inquiry subject" },
        "message": { "type": "string", "description": "The message body" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of submission" }
      },
      "required": ["name", "email", "subject", "message", "createdAt"]
    }
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": "submission",
      "description": "Collection of visitor inquiries"
    }
  }
}
